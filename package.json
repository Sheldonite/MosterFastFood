{
  "name": "ashfall-grove",
  "version": "0.1.0",
  "private": true,
  "author": "Sheldonite",
  "description": "A pixel food-fantasy boss roguelite for solo players and parties of four.",
  "main": "electron/main.js",
  "scripts": {
    "generate:art": "node scripts/generate-game-art.js",
    "check": "node scripts/check.js",
    "start": "node server.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win",
    "publish:win": "electron-builder --win --publish always",
    "generate:pixel": "node scripts/generate-pixel-art.js",
    "test": "node scripts/test-projectile-damage-once.js && node scripts/test-combat-balance.js && node scripts/test-signature-bosses.js && node scripts/test-arcade.js && node scripts/test-rogue.js && node scripts/test-condiment-fusion.js && node scripts/test-rogue-talents.js && node scripts/test-coop-server.js"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bossfight.game",
    "productName": "Boss Fight",
    "artifactName": "Boss-Fight-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "Sheldonite",
        "repo": "MosterFastFood"
      }
    ],
    "files": [
      "index.html",
      "src/**/*",
      "assets/**/*",
      "!assets/**/*.exe",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
